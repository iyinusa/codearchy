{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "outDir": "out",
        "rootDir": "src",
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "types": [
            "node"
        ]
    },
    "exclude": [
        "node_modules",
        ".vscode-test",
        "out",
        "webview-ui"
    ]
}